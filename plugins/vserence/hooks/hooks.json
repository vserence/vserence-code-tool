{
  "description": "vserence: контракт и бюджет контекста при старте, маршрутизация задач, format+lint после правок, защита тестов/секретов/опасных команд, Stop-ворота",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session-check.js"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/prompt-router.js"
            ],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
